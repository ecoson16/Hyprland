{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "padding": {
      "top": 1,
      "right": 3,
      "left": 1
    }
  },
  "display": {
    "separator": ": ",
    "color": {
      "keys": "#CBA6F7",
      "output": "#CDD6F4",
      "separator": "#6C7086"
    },
    "key": {
      "width": 18,
      "type": "both"
    },
    "percent": {
      "type": 3
    },
    "bar": {
      "width": 8,
      "char": {
        "elapsed": "━",
        "total": "─"
      },
      "border": {
        "left": "[",
        "right": "]"
      }
    },
    "size": {
      "binaryPrefix": "iec",
      "ndigits": 1
    },
    "temp": {
      "unit": "C",
      "ndigits": 0
    }
  },
  "modules": [
    {
      "type": "os",
      "key": "OS"
    },
    {
      "type": "host",
      "key": "Host"
    },
    {
      "type": "kernel",
      "key": "Kernel"
    },
    {
      "type": "uptime",
      "key": "Uptime"
    },
    {
      "type": "packages",
      "key": "Packages"
    },
    {
      "type": "shell",
      "key": "Shell"
    },
    {
      "type": "monitor",
      "key": "Monitor"
    },
    {
      "type": "lm",
      "key": "Login Manager"
    },
    {
      "type": "wm",
      "key": "Window Manager"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "showPeCoreCount": true,
      "temp": true
    },
    {
      "type": "gpu",
      "key": "GPU",
      "driverSpecific": true,
      "temp": true
    },
    {
      "type": "memory",
      "key": "Memory",
      "percent": {
        "type": 1
      }
    },
    {
      "type": "swap",
      "key": "Swap",
      "separate": true,
      "percent": {
        "type": 1
      }
    },
    {
      "type": "disk",
      "key": "Disk",
      "percent": {
        "type": 1
      }
    },
    {
      "type": "dns",
      "key": "DNS"
    },
    {
      "type": "tpm",
      "key": "TPM"
    },
    {
      "type": "physicaldisk",
      "key": "Physical Disk",
      "hideVirtual": true,
      "hideUnused": true
    },
    {
      "type": "battery",
      "key": "Battery",
      "format": "{capacity} ({status})"
    },
    {
      "type": "bios",
      "key": "BIOS",
      "format": "{vendor} {version} ({date})"
    },
    {
      "type": "initsystem",
      "key": "Init System"
    },
    {
      "type": "de",
      "key": "DE"
    },
    {
      "type": "break"
    },
    {
      "type": "colors",
      "symbol": "block",
      "block": {
        "width": 4,
        "range": [
          0,
          15
        ]
      }
    }
  ]
}
